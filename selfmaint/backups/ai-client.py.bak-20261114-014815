    def _build_calc_page(self, page):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        kind = page["kind"]
        if kind == "intro":
            title = Gtk.Label()
            title.set_markup(f"<b>{page['title']}</b>")
            title.set_xalign(0.0)
            box.append(title)
            body = Gtk.Label(label=page["body"])
            body.set_wrap(True)
            body.set_xalign(0.0)
            box.append(body)
        elif kind == "text":
            prompt = Gtk.Label(label=page["prompt"])
            prompt.set_xalign(0.0)
            box.append(prompt)
            entry = Gtk.Entry()
            entry.connect("activate", self._calc_next)
            box.append(entry)
            self.calc_entries[page["id"]] = entry
        elif kind == "choice":
            prompt = Gtk.Label(label=page["prompt"])
            prompt.set_xalign(0.0)
            box.append(prompt)
            group = None
            buttons = []
            for opt in page["options"]:
                btn = Gtk.CheckButton(label=opt["label"])
                if group is not None:
                    btn.set_group(group)
                else:
                    group = btn
                box.append(btn)
                buttons.append((btn, opt))
            self.calc_choices[page["id"]] = buttons
        elif kind == "statement":
            text = Gtk.Label(label=page["text"])
            text.set_wrap(True)
            text.set_xalign(0.0)
            box.append(text)
            group = None
            buttons = []
            options = [{"label": "Agree", "weight": page["agree_pts"]},
                       {"label": "Disagree", "weight": page["disagree_pts"]}]
            for opt in options:
                btn = Gtk.CheckButton(label=opt["label"])
                if group is not None:
                    btn.set_group(group)
                else:
                    group = btn
                box.append(btn)
                buttons.append((btn, opt))
            self.calc_choices[page["id"]] = buttons
        elif kind == "summary":
            lbl = Gtk.Label(label="")
            lbl.set_xalign(0.0)
            lbl.set_wrap(True)
            box.append(lbl)
            self.calc_summary_label = lbl
        return box

    def _calc_start_plain(self, *_args):
        # The default theme option, taken head-on: plain chatbot &
        # reminders, no calculator run. The theme persists for the
        # next opening, and the base floor runs in this theme
        # exactly as in every other — wake and dwell only.
        self._set_theme(DEFAULT_THEME, "plain-start")
        self.calc_status.set_text(
            "Theme set: Plain Chatbot & Reminders — and the base "
            "floor still runs, on wake and dwell only.")

    def _calc_on_status(self, text):
        GLib.idle_add(self.calc_status.set_text, text)

    def _calc_show_page(self, index):
        self.calc_index = index
        self.calc_stack.set_visible_child_name(f"page-{index}")
        self.calc_progress.set_text(f"Step {index + 1} of {len(PAGES)}")
        page = PAGES[index]
        kind = page["kind"]
        last = index == len(PAGES) - 1
        self.calc_back_btn.set_visible(True)
        self.calc_back_btn.set_sensitive(index > 0)
        self.calc_next_btn.set_visible(not last)
        self.calc_skip_btn.set_visible(kind == "statement")
        self.calc_end_btn.set_visible(not last)
        self.calc_later_btn.set_visible(not last)
        # Curiosity-nudge copy (DRAFT): the Continue label and the
        # teaser line invite the next page open; they never block the
        # exits, which sit in the same row.
        if kind == "intro":
            self.calc_next_btn.set_label("Keep going \u2192")
            self.calc_teaser.set_text("Here's the shape of it — the "
                                      "statements come next.")
        elif kind == "statement":
            self.calc_next_btn.set_label("Next statement \u2192")
            self.calc_teaser.set_text("One honest answer at a time — "
                                      "the picture sharpens as you go.")
        if kind == "summary":
            self._calc_refresh_summary()

    def _calc_collect(self, page):
        """Return (answer, weight) for a question page, or None if blank."""
        if page["kind"] == "text":
            text = self.calc_entries[page["id"]].get_text().strip()
            if not text:
                return None
            return text, page.get("points", 0)
        if page["kind"] in ("choice", "statement"):
            for btn, opt in self.calc_choices[page["id"]]:
                if btn.get_active():
                    return opt["label"], opt["weight"]
            return None
        return None

    def _calc_next(self, *_args):
        page = PAGES[self.calc_index]
        if page["kind"] in ("text", "choice", "statement"):
            got = self._calc_collect(page)
            if got is not None:
                answer, weight = got
                self.calc_answers[page["id"]] = {"answer": answer, "weight": weight}
                self.calc_skipped.discard(page["id"])
                depth = compute_depth(self.calc_answers)
                self.calc_writer.record(page["id"],
                                        page.get("prompt", page.get("text", "")),
                                        answer, weight=weight, profile=depth)
                self._calc_refresh_live()
        if self.calc_index < len(PAGES) - 1:
            self._calc_show_page(self.calc_index + 1)

    # --- Default mode exits: Skip / End / Finish later (always there) ---

    def _calc_skip(self, *_args):
        page = PAGES[self.calc_index]
        if page["kind"] != "statement":
            return
        # A skip is data, streamed like any answer, marked "skipped";
        # it carries no depth signal either way.
        self.calc_skipped.add(page["id"])
        self.calc_answers.pop(page["id"], None)
        self.calc_writer.record_skip(page["id"], page["text"],
                                     profile=compute_depth(self.calc_answers))
        self._calc_refresh_live()
        if self.calc_index < len(PAGES) - 1:
            self._calc_show_page(self.calc_index + 1)

    def _calc_end(self, *_args):
        # Stop now: the summary reads whatever pattern exists so far.
        self._calc_show_page(len(PAGES) - 1)

    def _calc_finish_later(self, *_args):
        self.calc_writer.save_progress(self.calc_index, self.calc_answers,
                                       done=False)
        self._calc_show_special("paused")

    def _calc_show_special(self, name):
        self.calc_stack.set_visible_child_name(name)
        self.calc_progress.set_text("Paused" if name == "paused"
                                    else "Welcome back")
        self.calc_teaser.set_text("")
        for btn in (self.calc_back_btn, self.calc_skip_btn,
                    self.calc_end_btn, self.calc_later_btn,
                    self.calc_next_btn):
            btn.set_visible(False)

    def _calc_resume(self, *_args):
        if self.calc_resume_data:
            data = self.calc_resume_data
            self.calc_resume_data = None
            # Continue the same backend session the marker names.
            self.calc_writer = EngagementWriter(
                session_id=data["session"],
                on_status=self._calc_on_status)
            self.calc_status.set_text(self.calc_writer.status_text())
            self.calc_answers = {sid: {"answer": a}
                                 for sid, a in data["answers"].items()}
            for sid, a in self.calc_answers.items():
                for btn, opt in self.calc_choices.get(sid, []):
                    if opt["label"] == a["answer"]:
                        btn.set_active(True)
            self._calc_refresh_live()
            self._calc_show_page(min(data["page_index"], len(PAGES) - 1))
        else:
            self._calc_show_page(self.calc_index)

    def _calc_start_over(self, *_args):
        if self.calc_resume_data:
            # Close the stored session so it isn't offered again.
            stale = EngagementWriter(
                session_id=self.calc_resume_data["session"],
                on_status=None)
            stale.save_progress(0, {}, done=True)
            self.calc_resume_data = None
        self._calc_show_page(0)

    def _calc_back(self, *_args):
        if self.calc_index > 0:
            self._calc_show_page(self.calc_index - 1)

    def _calc_refresh_live(self):
        depth = compute_depth(self.calc_answers)
        if depth["answered"]:
            self.calc_live.set_text(
                f"Depth so far: {depth['level_name']} \u2014 {depth['score']} of "
                f"{depth['max_score']} depth points, based on "
                f"{depth['answered']} of {depth['total']} statements")
        else:
            self.calc_live.set_text("Depth so far: nothing answered yet")

    def _calc_refresh_summary(self):
        depth = compute_depth(self.calc_answers)
        lines = [f"Where the relationship begins: {depth['level_name']}",
                 depth["meaning"], ""]
        lines += depth["lines"]
        if depth["answered"] < depth["total"]:
            lines += ["",
                      f"A partial read is a shallower read: this depth "
                      f"is based on {depth['answered']} of "
                      f"{depth['total']} statements"
                      + (f" ({len(self.calc_skipped)} skipped — a skip "
                         f"says nothing either way)."
                         if self.calc_skipped else ".")]
        # The depth becomes the theme the app runs under — named
        # here, persisted for the next opening, proposed there as
        # the relationship.
        theme = theme_for_level(depth["level"])
        lines += ["",
                  f"You begin under the {theme['name']} theme.",
                  theme["behaves_as"],
                  theme["floor_note"]]
        lines += ["", depth["time_line"]]
        self.calc_summary_label.set_text("\n".join(lines))
        if self.calc_theme_level != theme["level"]:
            self.calc_theme_level = theme["level"]
            self._set_theme(theme, "calculator")
        if not self.calc_done_sent:
            self.calc_done_sent = True
            self.calc_writer.save_progress(self.calc_index,
                                           self.calc_answers, done=True)

