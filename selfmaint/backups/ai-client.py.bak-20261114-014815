        return False

    def _refresh_daughters_label(self):
        if not hasattr(self, "daughters_label"):
            return
        try:
            daughters = hybrid_mod.read_daughters(
                pair_secret=setup_mod.load_secret("pairing-secret"),
                stale_minutes=self.options.get(
                    "hybrid", "stale_minutes"))
        except Exception:
            daughters = {}
        if not daughters:
            self.daughters_label.set_text(
                "No daughters paired yet — pair one from the "
                "Setup door.")
            return
        lines = []
        for did, d in sorted(daughters.items()):
            age = d["age_s"]
            lines.append(
                f"{did}: last brief "
                f"{'?' if age is None else int(age)}s ago"
                f"{' (stale)' if d['stale'] else ''} · "
                f"pair {'verified' if d['verified'] else 'unverified'}"
                f" · chain {'ok' if d['chain_ok'] else 'BROKEN'}"
                f" · head {d['entry']['hash'][:12]}")
        self.daughters_label.set_text("\n".join(lines))

