    def _floor_summary(self):
        """One calm line from the floor's last snapshot."""
        mon = self.floor_monitor
        snap = mon.last_snapshot if mon else None
        if not snap:
            return "Floor: checking home…"
        bits = [f"Floor: {'aligned' if snap.get('aligned') else 'not aligned'}"
                f" — {len(snap.get('up', []))}/"
                f"{len(snap.get('services', {}))} organs answering"]
        if snap.get("mismatches"):
            bits.append(f"{len(snap['mismatches'])} mismatch(es)")
        if snap.get("processes") is not None:
            bits.append(f"{snap['processes']} processes")
        daughters = snap.get("daughters") or {}
        for did, d in daughters.items():
            age = d.get("age_s")
            bits.append(f"daughter {did}: last brief "
                        f"{'?' if age is None else int(age)}s ago"
                        + (" (stale)" if d.get("stale") else ""))
        return " · ".join(bits)

