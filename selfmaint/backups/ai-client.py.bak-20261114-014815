    def _opt_choice(self, parent, label, values, current, on_pick,
                    costs=None):
        """One labeled choice row: a dropdown of values, each with
        its one-line cost/effect shown beside it."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                      spacing=8)
        lbl = Gtk.Label(label=label)
        lbl.set_xalign(0.0); lbl.set_hexpand(True)
        row.append(lbl)
        store = Gtk.StringList.new([str(v) for v in values])
        dd = Gtk.DropDown(model=store)
        try:
            dd.set_selected(values.index(current))
        except ValueError:
            pass
        cost = Gtk.Label(label=(costs or {}).get(current, ""))
        cost.set_xalign(0.0)

        def _changed(d, _pspec):
            value = values[d.get_selected()]
            cost.set_text((costs or {}).get(value, ""))
            on_pick(value)
        dd.connect("notify::selected-item", _changed)
        row.append(dd)
        row.append(cost)
        parent.append(row)
        return dd

