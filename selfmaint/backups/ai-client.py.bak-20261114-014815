            host = self.options.get("hybrid", "parent_host") \
                if role == "daughter" else "127.0.0.1"
            self.daughter_runtime = hybrid_mod.DaughterRuntime(
                self.options.get("hybrid", "daughter_id"),
                hybrid_mod.ChainStore(sd / "daughter-chain.json"),
                hybrid_mod.BriefQueue(sd / "daughter-queue.jsonl"),
                host, self.options.get("hybrid", "parent_port"),
                pair_secret=setup_mod.load_secret("pairing-secret"))
        probe = self._daughters_probe \
            if role in ("parent", "hybrid") else None
        self.floor_monitor = FloorMonitor(
            theme=self.theme,
            interval=self.options.dwell_seconds(),
            companion=self._beat_companion,
            daughters_probe=probe)
        threading.Thread(target=self.floor_monitor.wake,
                         daemon=True).start()
        self.floor_monitor.start()
        self.connect("shutdown",
                     lambda *_: self.floor_monitor
                     and self.floor_monitor.stop())
