    def _compute_cycle(self, prompt_text):
        # If an image was attached, route through LLaVA
        file_path = self.attached_file
        self.attached_file = None
        if file_path and file_path.lower().endswith(('.png', '.jpg', '.jpeg', '.webp')):
            self._compute_vision_response(prompt_text, file_path)
            return

        self.history.append({"role": "user", "content": prompt_text})

        run_tool_loop(self.history, self._ollama_chat, self._emit_bubble,
                      execute=self._execute_tool_payload,
                      max_loops=self.max_loops)

    def _compute_vision_response(self, prompt_text, file_path):
        """Route an attached image through LLaVA vision model."""
        if self.options is not None \
                and not self.options.sense_live("vision"):
            GLib.idle_add(self.append_bubble,
                          "The vision organ is off (Options → "
                          "Senses), so the attachment wasn't read. "
                          "The floor still checks the service; the "
                          "organ just doesn't take new work.",
                          "ai")
            return
        try:
            with open(file_path, "rb") as f:
                b64 = base64.b64encode(f.read()).decode('utf-8')
            
            GLib.idle_add(self.append_bubble, "⚡ Routing through LLaVA vision...", "user")
            
            msg = {"role": "user", "content": prompt_text, "images": [b64]}
            payload = json.dumps({
                "model": "llava:7b",
                "messages": [msg],
                "stream": False
            }).encode()
            
            req = urllib.request.Request(
                f"{OLLAMA_URL}/api/chat",
                data=payload,
                headers={"Content-Type": "application/json"}
            )
            
            with urllib.request.urlopen(req) as r:
                res = json.loads(r.read().decode())
                response = res.get("message", {}).get("content", "Empty response")
            
            GLib.idle_add(self.append_bubble, response, "ai")
            
        except Exception as e:
            GLib.idle_add(self.append_bubble, f"Vision error: {str(e)}", "ai")

    def _ollama_chat(self, history):
        """One chat round-trip, served by the chat stack: the
        first reachable entry the standing cloud policy allows.
        The header learns who served; under the drafts-only
        policy a cloud answer is labeled a draft on its face —
        nothing is swapped silently."""
        if self.stacks is None:
            entry = {"kind": "ollama", "model": self.model}
            return model_stacks.chat_completion(
                entry, history,
                timeout=self.options.get("patience",
                                         "turn_timeout_s")
                if self.options else 30)
        budget = self.options.get("cloud", "session_budget")
        budget_ok = budget is None or self.cloud_used < budget
        entry, report = model_stacks.resolve_chat_entry(
            self.stacks,
            policy=self.options.get("cloud", "policy"),
            budget_ok=budget_ok)
        self.stack_status["chat-report"] = report
        if entry is None:
            lines = "; ".join(
                f"{model_stacks.entry_label(e)}: {v}"
                for e, v in report) or "the stack is empty"
            raise RuntimeError(
                f"No chat entry could serve ({lines}). Add one "
                f"under Models, or start Ollama.")
        self._serving = entry
        GLib.idle_add(self._refresh_serving_label)
        text = model_stacks.chat_completion(
            entry, history,
            timeout=self.options.get("patience", "turn_timeout_s"))
        if not model_stacks.is_local(entry):
            self.cloud_used += 1
            if self.options.get("cloud", "policy") == "draft":
                text = ("(cloud draft — policy is drafts-only)\n"
                        + text)
        return text

    def _refresh_serving_label(self):
        if hasattr(self, "serving_label") and self._serving:
            self.serving_label.set_text(
                "serving: "
                + model_stacks.entry_label(self._serving))
        return False

    def _emit_bubble(self, text, sender):
        GLib.idle_add(self.append_bubble, text, sender)

    def _execute_tool_payload(self, tool_string):
        # Senses gate: an organ switched off in Options takes no
        # new work. The floor still health-checks it — off means
        # quiet, not gone.
        if self.options is not None \
                and is_tool_call(tool_string.strip()):
            try:
                svc = parse_tool_token(tool_string.strip())[0]
            except Exception:
                svc = None
            if svc in SERVICE_PORTS \
                    and not self.options.sense_live(svc):
                return (f"{svc} organ is off — Options → "
                        f"Senses; the floor still checks it")
        return execute_tool_payload(tool_string)

    def _monitor_services(self):
        while True:
            for name, (port, _) in MCP.items():
                try:
                    with socket.create_connection(("127.0.0.1", port), timeout=0.5):
                        GLib.idle_add(self._update_indicator, name, True)
                except Exception:
                    GLib.idle_add(self._update_indicator, name, False)
            GLib.idle_add(self._maybe_update_floor_label)
            time.sleep(self.poll_seconds)

    def _update_indicator(self, name, active):
        self.service_up[name] = active
        ind = self.indicators.get(name)
        if ind:
            if active:
                ind.set_markup("<span foreground='#2ec27e'>●</span>")
            else:
                ind.set_markup("<span foreground='#e01b24'>●</span>")

