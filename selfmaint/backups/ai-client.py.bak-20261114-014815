    def _open_config_editor(self):
        path = os.path.join(os.path.dirname(__file__), "..",
                            "config.json")
        try:
            with open(path) as f:
                initial = f.read()
        except OSError:
            initial = "{}"
        dialog = Gtk.Dialog(title="config.json — validate, "
                                  "then save",
                            transient_for=self.win, modal=True)
        dialog.set_default_size(620, 480)
        area = dialog.get_content_area()
        view = Gtk.TextView()
        view.set_monospace(True)
        view.get_buffer().set_text(initial)
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_child(view)
        area.append(scroller)
        status = Gtk.Label(label="Validate runs the wire "
                                 "protocol against the live "
                                 "services before a save is "
                                 "allowed.")
        status.set_wrap(True); status.set_xalign(0.0)
        area.append(status)

        def _text():
            buf = view.get_buffer()
            return buf.get_text(buf.get_start_iter(),
                                buf.get_end_iter(), False)

        def _validate(_b):
            ok, problems = setup_mod.validate_config_text(_text())
            lines = setup_mod.probe_config_ports(_text())
            status.set_text(
                ("Valid. " if ok else
                 "Problems: " + "; ".join(problems) + " ")
                + "\n".join(lines))
            return ok

        val_btn = Gtk.Button(label="Validate")
        val_btn.connect("clicked", _validate)
        area.append(val_btn)

        def _save(_b):
            ok, problems = setup_mod.validate_config_text(_text())
            if not ok:
                status.set_text("Not saved — problems: "
                                + "; ".join(problems))
                return
            try:
                with open(path + ".bak", "w") as f:
                    f.write(initial)
                with open(path, "w") as f:
