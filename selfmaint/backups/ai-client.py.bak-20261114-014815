    def _on_setup_next(self, btn):
        plan = self.setup_state.get("plan")
        if not plan:
            self.setup_status.set_text("Build the plan first.")
            return
        level = self.setup_state["level"]
        if level == 0:
            self.setup_status.set_text(
                "Level 0 is look-only — raise the comfort level "
                "to run steps.")
            return
        runnable, _held = setup_mod.steps_for_level(plan, level)
        idx = self.setup_state["next"]
        if idx >= len(runnable):
            self.setup_status.set_text(
                "Thread complete at this level — held steps are "
                "listed in the plan, waiting on a higher level.")
            return
        step = runnable[idx]
        if step["needs"] == "sudo" and level == 2:
            self._confirm_sudo_step(step)
            return
        self._run_setup_step(step)

    def _confirm_sudo_step(self, step):
        dialog = Gtk.Dialog(
            title="A sudo step — the exact commands",
            transient_for=self.win, modal=True)
        area = dialog.get_content_area()
        lbl = Gtk.Label(
            label=f"{step['title']}\n\n"
                  + "\n".join(step["commands"])
                  + "\n\nNothing else runs. Your call.")
        lbl.set_wrap(True); lbl.set_xalign(0.0)
        area.append(lbl)
        dialog.add_button("Don't run it", Gtk.ResponseType.CANCEL)
        dialog.add_button("Run exactly this",
                          Gtk.ResponseType.ACCEPT)

        def _resp(d, r):
            d.destroy()
            if r == Gtk.ResponseType.ACCEPT:
                self._run_setup_step(step)
            else:
                self.setup_status.set_text(
                    f"Skipped by you: {step['title']}. The "
                    f"thread waits.")
        dialog.connect("response", _resp)
        dialog.present()

    def _run_setup_step(self, step):
        self.setup_state["next"] += 1
        if step.get("kind") != "run" or not step["commands"]:
            self.setup_state["receipts"].append({
                "step": step["id"], "kind": step.get("kind"),
                "result": "guided/config — completed by hand, "
                          "marked so"})
            self.setup_status.set_text(
                f"{step['title']}: guided/config step — its "
                f"note in the plan is the instruction; marked "
                f"done by hand.")
            return

        def work():
            codes = []
            for cmd in step["commands"]:
                proc = subprocess.run(cmd, shell=True,
                                      capture_output=True,
                                      text=True, timeout=1800)
                codes.append(proc.returncode)
                if proc.returncode != 0:
                    tail = (proc.stderr or proc.stdout or "")[-300:]
                    self.setup_state["receipts"].append({
                        "step": step["id"], "codes": codes,
                        "failed": cmd, "tail": tail})
                    GLib.idle_add(
                        self.setup_status.set_text,
                        f"Stopped at {step['title']}: `{cmd}` "
                        f"exited {proc.returncode}. {tail} — "
                        f"retry, skip, or abort from here; "
                        f"nothing else ran.")
                    return
            self.setup_state["receipts"].append({
                "step": step["id"], "codes": codes,
                "result": "ok"})
            GLib.idle_add(
                self.setup_status.set_text,
                f"Done: {step['title']} (exit codes {codes}). "
                f"Receipt kept; next step waits for its "
                f"button.")
        threading.Thread(target=work, daemon=True).start()
        self.setup_status.set_text(f"Running: {step['title']}…")

