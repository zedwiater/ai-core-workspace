    def _on_toy_press(self, gesture, n_press, x, y):
        self.toy_eddies = toy_mod.poke(self.toy_eddies, x, y,
                                       self.toy_rng)
        self.toy_area.queue_draw()

    def _toy_tick(self):
        w = self.toy_area.get_width()
        h = self.toy_area.get_height()
        if w > 10 and h > 10 and self.toy_eddies:
            self.toy_eddies = toy_mod.step(
                self.toy_eddies, w, h, 0.05, self.toy_rng)
        self.toy_area.queue_draw()
        return True

    def _toy_draw(self, area, cr, w, h):
        cr.set_source_rgb(0.07, 0.10, 0.15)
        cr.paint()
        t = time.time()
        for e in self.toy_eddies:
            r, g, b = e.color(t)
            cr.set_source_rgba(r, g, b, 0.7)
            cr.arc(e.x, e.y, e.draw_radius(), 0, 6.2832)
            cr.fill()
            cr.set_source_rgba(r, g, b, 0.95)
            cr.arc(e.x + e.spin * e.draw_radius() * 0.45,
                   e.y - e.draw_radius() * 0.2,
                   max(2.0, e.draw_radius() * 0.16), 0, 6.2832)
            cr.fill()

