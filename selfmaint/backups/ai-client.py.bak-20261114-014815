            add.append(key_e); add.append(add_btn)
            inner.append(add)
            self.slot_add[slot] = (url_e, model_e, key_e)
            self._render_slot(slot)
        disc = Gtk.Button(label="Add all discovered Ollama "
                                "models to the chat stack")
