    def _maybe_update_floor_label(self):
        """Refresh the calm line when a new snapshot lands, and
        say so (once per change) when organs drop or return —
        degradation announced, never silent."""
        mon = self.floor_monitor
        if mon is None or mon.last_snapshot is None:
            return False
        snap = mon.last_snapshot
        if snap.get("ts") == self._last_floor_ts:
            return False
        self._last_floor_ts = snap.get("ts")
        if hasattr(self, "floor_label"):
            self.floor_label.set_text(self._floor_summary())
        down = set(snap.get("down", []))
        if self.options and self.options.get(
                "redundancy", "degradation_notices"):
            newly = down - self._last_down
            back = self._last_down - down
            for n in sorted(newly):
                self.append_bubble(
                    f"⚠ {n} stopped answering — the floor notes "
                    f"it; the rest of the house carries on.",
                    "system")
            for n in sorted(back):
                self.append_bubble(f"✓ {n} is answering again.",
                                   "system")
        self._last_down = down
        return False

    # --- The floor's companions: self-maintenance + daughter -----

    def _beat_companion(self, snapshot):
        """Runs on the floor's wake/dwell beats only (the floor
        calls it) — self-maintenance takes its census, the
        daughter half sends its brief. Never mid-conversation."""
        if self._profile is None:
            try:
                self._profile = setup_mod.detect_profile()
            except Exception:
                self._profile = {}
        if self.maintainer is not None:
            self.maintainer.run_beat(
                snapshot.get("beat", "dwell"),
                profile=self._profile or None)
            n = self.maintainer.take_announcement()
            if n:
                GLib.idle_add(
                    self.append_bubble,
                    f"🛠 The app repaired {n} thing(s) about "
                    f"itself on the {snapshot.get('beat', 'dwell')} "
                    f"beat — receipts under Options → "
                    f"Self-maintenance.", "system")
            GLib.idle_add(self._refresh_selfmaint_label)
        if self.daughter_runtime is not None:
            self.daughter_runtime.beat(snapshot)
        GLib.idle_add(self._maybe_update_floor_label)

