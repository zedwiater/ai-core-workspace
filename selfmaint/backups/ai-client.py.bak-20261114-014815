    def _fetch_models(self):
        try:
            req = urllib.request.Request(f"{OLLAMA_URL}/api/tags")
            with urllib.request.urlopen(req, timeout=1.5) as r:
                data = json.loads(r.read().decode())
                return [m['name'] for m in data.get('models', [])]
        except Exception:
            # config.json's offered model is the fallback pick —
            # the config is honored, not decoration.
            return [self.cfg.get("model") or "qwen3.5:9b"]

    def _load_config(self):
        """Read source/config.json (the app's offered values)."""
        try:
            path = os.path.join(os.path.dirname(__file__), "..",
                                "config.json")
            with open(path) as f:
                cfg = json.load(f)
            return cfg if isinstance(cfg, dict) else {}
        except Exception:
            return {}

    def _tree_root(self):
        """Where the app's tree lives: the repo root in the source
        layout, the install root in the installed layout."""
        app_dir = os.path.dirname(os.path.abspath(__file__))
        parent = os.path.abspath(os.path.join(app_dir, ".."))
        if os.path.isdir(os.path.join(parent, "app")) \
                and os.path.isdir(os.path.join(parent, "core")):
            return parent
        return os.path.abspath(os.path.join(parent, ".."))

