    def _on_close(self, *_args):
        if self.toy_source is not None:
            GLib.source_remove(self.toy_source)
            self.toy_source = None
        if self.floor_monitor is not None:
            self.floor_monitor.stop()
        return False

    # --- Themes: the relationship the app proposes on opening ---

    def _apply_theme_label(self):
        if hasattr(self, "rel_label"):
            self.rel_label.set_text(
                f"Relationship: {self.theme['name']}")
        if hasattr(self, "calc_theme_label"):
            self.calc_theme_label.set_text(
                f"Theme on opening: {self.theme['name']}")

    def _set_theme(self, theme, set_by):
        """Make a theme the standing one: persist it, stamp it into
        the floor's snapshots, and show it as the relationship."""
        self.theme = theme
        save_theme(theme, set_by)
        if self.floor_monitor is not None:
            self.floor_monitor.theme = theme
        self._apply_theme_label()

