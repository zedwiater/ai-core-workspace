    def _render_slot(self, slot):
        box = self.slot_rows.get(slot)
        if box is None:
            return
        child = box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt
        entries = (self.stacks or {}).get(slot, [])
        if not entries:
            lbl = Gtk.Label(label="(empty — add an entry below)")
            lbl.set_xalign(0.0)
            box.append(lbl)
            return
        for i, entry in enumerate(entries):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                          spacing=6)
            status = self.stack_status.get((slot, i), "")
            lbl = Gtk.Label(
                label=f"{i + 1}. "
                      f"{model_stacks.entry_label(entry)}"
                      + (f"  — {status}" if status else ""))
            lbl.set_xalign(0.0); lbl.set_hexpand(True)
            row.append(lbl)
            up = Gtk.Button(label="↑")
            up.set_sensitive(i > 0)
            up.connect("clicked", self._on_slot_move, slot, i, -1)
            row.append(up)
            rm = Gtk.Button(label="✕")
            rm.connect("clicked", self._on_slot_remove, slot, i)
            row.append(rm)
            box.append(row)

    def _save_stacks_and_render(self):
        model_stacks.save_stacks(self.stacks)
        for slot in model_stacks.SLOTS:
            self._render_slot(slot)
        self.models_status.set_text(
            "Stacks saved to the memory service.")

    def _on_slot_add(self, btn, slot, url_e, model_e, key_e):
        url = url_e.get_text().strip()
        model = model_e.get_text().strip()
        if not model and not url:
            self.models_status.set_text(
                "An entry needs at least a model name (Ollama) "
                "or an endpoint + model.")
            return
        if url:
            entry = {"kind": "openai", "base_url": url.rstrip("/"),
                     "model": model}
            key = key_e.get_text().strip()
            if key:
                entry["api_key"] = key
        else:
            entry = {"kind": "ollama", "model": model}
        self.stacks[slot].append(entry)
        url_e.set_text(""); model_e.set_text(""); key_e.set_text("")
        self._save_stacks_and_render()

    def _on_slot_move(self, btn, slot, i, delta):
        entries = self.stacks[slot]
        j = i + delta
        if 0 <= j < len(entries):
            entries[i], entries[j] = entries[j], entries[i]
            self._save_stacks_and_render()

    def _on_slot_remove(self, btn, slot, i):
        del self.stacks[slot][i]
        self._save_stacks_and_render()

    def _on_discover_add(self, btn):
        found = model_stacks.discover_ollama()
        have = {e.get("model") for e in self.stacks["chat"]
                if e.get("kind") == "ollama"}
        added = 0
        for name in found:
            if name not in have:
                self.stacks["chat"].append(
                    {"kind": "ollama", "model": name})
                added += 1
        self.models_status.set_text(
            f"Ollama discovery: {len(found)} model(s) present, "
            f"{added} new entr(ies) added to the chat stack.")
        self._save_stacks_and_render()

    def _on_probe_stacks(self, btn):
        def work():
            for slot in model_stacks.SLOTS:
                for i, entry in enumerate(
                        self.stacks.get(slot, [])):
                    probe = model_stacks.probe_entry(entry)
                    self.stack_status[(slot, i)] = probe["state"]
            GLib.idle_add(self._render_all_slots)
        threading.Thread(target=work, daemon=True).start()
        self.models_status.set_text("Probing…")

    def _render_all_slots(self):
        for slot in model_stacks.SLOTS:
            self._render_slot(slot)
        self.models_status.set_text("Probe complete.")
        return False

