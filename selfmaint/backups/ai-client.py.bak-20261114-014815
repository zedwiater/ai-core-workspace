        # explainers from earlier beats rejoin the registry, and
        # the maintainer rides the wake/dwell beats as the
        # floor's companion — never a third beat, never
        # mid-conversation.
        root = self._tree_root()
        sm_state = os.path.join(root, "selfmaint")
        gen_path = os.path.join(sm_state, "generated_explainers.json")
        if os.path.exists(gen_path):
            try:
                with open(gen_path) as f:
                    learn_mod.register_generated(json.load(f))
            except Exception:
                pass
        self.maintainer = SelfMaintainer(root, state_dir=sm_state)
